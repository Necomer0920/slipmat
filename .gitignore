*.iml
.gradle
/local.properties

# Android Studio rewrites these constantly and they are specific to one machine —
# which device you last deployed to, local inspection profiles, SDK paths. Keeping
# them out means a diff only ever shows real changes.
/.idea/
.DS_Store
# Any module's build output, not just the root's. `/build` matched only the root, so a new
# module without its own .gitignore quietly committed 498 files of build output.
build/
/captures
.externalNativeBuild
.cxx
local.properties
